# Banco PostgreSQL (na Vercel, use a integração Neon: ela cria estas variáveis sozinha)
DATABASE_URL="postgresql://app:app@localhost:5432/consultorio"
# DATABASE_URL_UNPOOLED="postgresql://..."   # opcional, usado nas migrações

# Segredo para assinar a sessão de login. Gere com:  openssl rand -base64 32
AUTH_SECRET=""

# Chave para criptografar as chaves de API e as anotações no banco.
# Gere com:  openssl rand -base64 32
# ATENÇÃO: se perder ou trocar esta chave, as anotações salvas não poderão ser lidas.
ENCRYPTION_KEY=""

# Segredo que o serviço de cron externo envia para disparar os lembretes
CRON_SECRET=""

# Endereço público do site (usado no retorno do login do Google)
APP_URL="http://localhost:3000"
